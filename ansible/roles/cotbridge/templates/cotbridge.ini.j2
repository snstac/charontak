# Managed by Ansible — role cotbridge

[cotbridge]
{% for opt, val in cotbridge_global_options | dictsort %}
{{ opt }} = {{ val }}
{% endfor %}

{% if cotbridge_ini_extra | default('') | length > 0 %}
{{ cotbridge_ini_extra }}
{% endif %}

{% for lane in cotbridge_lanes %}
[lane:{{ lane.name }}]
{% for k, v in lane | dictsort %}
{% if k != 'name' %}
{{ k }} = {{ v }}
{% endif %}
{% endfor %}

{% endfor %}
