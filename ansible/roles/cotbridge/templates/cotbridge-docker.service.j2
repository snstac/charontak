[Unit]
Description=COTBridge + Cockpit (docker compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ cotbridge_repo_dir }}/deploy/docker
ExecStart=/usr/bin/docker compose -f docker-compose.yml --profile {{ cotbridge_docker_profile }} up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.yml --profile {{ cotbridge_docker_profile }} down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
