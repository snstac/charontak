#
# /etc/default/charontak — environment for systemd charontak.service
#

CHARONTAK_CONFIG=/etc/charontak.ini

# Used by debian/charontak.postinst when creating the runtime user (adsbcot-style).
SERVER_USER=charontak
SERVER_GROUP=charontak
SERVER_HOME=/run/charontak
SERVER_NAME="Charontak PyTAK bridge system user"
