[Unit]
Description=Charontak PyTAK CoT echelon bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/charontak
ExecStart=/usr/local/bin/charontak --config ${CHARONTAK_CONFIG:-/etc/charontak.ini}
Restart=on-failure
RestartSec=3
# Uncomment to propagate DEBUG= from environment:
# Environment=DEBUG=

[Install]
WantedBy=multi-user.target
